---
const {
  label = "Like",
  thanks = "Thank you!",
} = Astro.props;
---

<button
  id="likeBtn"
  class="likeBtn"
  type="button"
  aria-label={label}
  title={label}
>
  <span id="heart" class="heart" aria-hidden="true">♡</span>
  <span id="likeCount" class="count">0</span>

  <span
    id="thanks"
    class="thanks"
    role="status"
    aria-live="polite"
    hidden
  >
    {thanks}
  </span>
</button>

<script is:inline>
  const likedKey = "liked_site_v1";

  // CounterAPI configuration
  const COUNTER_NAMESPACE = "saipisupati-appsec.github.io";
  const COUNTER_ACTION = "like";
  const COUNTER_KEY = "portfolio";

  const COUNTER_URL =
    `https://counterapi.com/api/${COUNTER_NAMESPACE}/${COUNTER_ACTION}/${COUNTER_KEY}`;

  async function initLikeFooter() {
    const btn = document.getElementById("likeBtn");
    const countEl = document.getElementById("likeCount");
    const heartEl = document.getElementById("heart");
    const thanksEl = document.getElementById("thanks");

    if (!btn || !countEl || !heartEl || !thanksEl) return;

    /*
     * Read the current like count.
     */
    const refresh = async () => {
      try {
        const response = await fetch(
          `${COUNTER_URL}?readOnly=true`,
          {
            cache: "no-store",
          }
        );

        if (!response.ok) {
          throw new Error(`CounterAPI returned ${response.status}`);
        }

        const data = await response.json();

        countEl.textContent = String(data.value ?? 0);

        if (localStorage.getItem(likedKey)) {
          heartEl.textContent = "♥";
        }
      } catch (error) {
        console.error("Unable to load like count:", error);
      }
    };

    /*
     * Bind the click handler only once.
     */
    if (!btn.dataset.bound) {
      btn.addEventListener("click", async () => {
        // Prevent the same browser from liking multiple times.
        if (localStorage.getItem(likedKey)) return;

        btn.classList.add("pop");
        btn.disabled = true;

        try {
          const response = await fetch(COUNTER_URL, {
            method: "GET",
            cache: "no-store",
          });

          if (!response.ok) {
            throw new Error(`CounterAPI returned ${response.status}`);
          }

          const data = await response.json();

          countEl.textContent = String(data.value ?? countEl.textContent);

          localStorage.setItem(likedKey, "1");
          heartEl.textContent = "♥";

          thanksEl.hidden = false;
          thanksEl.classList.add("show");

          setTimeout(() => {
            btn.classList.remove("pop");
          }, 350);

          setTimeout(() => {
            thanksEl.classList.remove("show");
            thanksEl.hidden = true;
          }, 1600);
        } catch (error) {
          console.error("Unable to register like:", error);

          btn.disabled = false;
          btn.classList.remove("pop");
        }
      });

      btn.dataset.bound = "1";
    }

    /*
     * Load current count.
     */
    refresh();
  }

  document.addEventListener("DOMContentLoaded", initLikeFooter);
  document.addEventListener("astro:page-load", initLikeFooter);
</script>

<style>
  .likeBtn {
    margin-left: 12px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 9999px;
  }

  .likeBtn:disabled {
    cursor: default;
  }

  .thanks {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%) translateY(6px);
    opacity: 0;
    pointer-events: none;

    white-space: nowrap;
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .thanks.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .heart {
    font-size: 20px;
    line-height: 1;
    transform-origin: center;
  }

  .count {
    font-size: 14px;
  }

  .likeBtn.pop .heart {
    animation: pop 0.35s ease;
  }

  @keyframes pop {
    0% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.35);
    }

    100% {
      transform: scale(1);
    }
  }
</style>